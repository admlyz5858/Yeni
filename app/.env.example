# Supabase (ZORUNLU - gerçek kullanıcı girişi için)
# 1. supabase.com → Yeni proje
# 2. Settings → API → URL ve anon key kopyala
# 3. SQL Editor'da supabase/migrations/*.sql çalıştır
# 4. Admin ataması: UPDATE profiles SET role='admin' WHERE email='sizin@email.com';
#
# Bu dosyayı .env olarak app/ klasöründe kopyalayın:
# cp .env.example .env
#
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
