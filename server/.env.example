# Server
PORT=3001

# Supabase (for user auth & notebook storage)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Cloud / NotebookLM Enterprise
# Option A: Static token (dev): gcloud auth print-access-token
# Option B: Service account (prod): set GOOGLE_APPLICATION_CREDENTIALS
NOTEBOOKLM_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_NUMBER=your_project_number
GCP_LOCATION=us
NOTEBOOKLM_BASE_URL=https://us-discoveryengine.googleapis.com/v1alpha

# Gemini API (for ask-ai context when NotebookLM query not available)
GEMINI_API_KEY=your_gemini_api_key
